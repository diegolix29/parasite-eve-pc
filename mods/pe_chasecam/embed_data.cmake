# Builds the chase camera's room data (every file in DATA_DIR: rooms.txt, textures/...) into the
# game as C arrays, so the mod needs no files on the player's machine.
#   cmake -DDATA_DIR=<mods/pe_chasecam/data> -DOUT=<generated .c> -P embed_data.cmake
file(GLOB_RECURSE files RELATIVE "${DATA_DIR}" "${DATA_DIR}/*")
list(SORT files)
set(body "")
set(table "")
set(count 0)
foreach(rel IN LISTS files)
    file(READ "${DATA_DIR}/${rel}" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char file_${count}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${rel}\", file_${count}, ${size}u},\n")
    math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}.tmp"
"/* Generated by mods/pe_chasecam/embed_data.cmake from mods/pe_chasecam/data: do not edit. */\n"
"typedef struct PeChasecamFile { const char *path; const unsigned char *data; unsigned size; } PeChasecamFile;\n"
"extern const PeChasecamFile pe_chasecam_files[];\n"
"extern const unsigned pe_chasecam_file_count;\n"
"${body}"
"const PeChasecamFile pe_chasecam_files[] = {\n${table}    {0, 0, 0}};\n"
"const unsigned pe_chasecam_file_count = ${count}u;\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
